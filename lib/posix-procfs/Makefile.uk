$(eval $(call addlib_s,libposix_procfs,$(CONFIG_LIBPOSIX_PROCFS)))

CINCLUDES-$(CONFIG_LIBPOSIX_PROCFS) += -I$(LIBPOSIX_PROCFS_BASE)/include
CXXINCLUDES-$(CONFIG_LIBPOSIX_PROCFS) += -I$(LIBPOSIX_PROCFS_BASE)/include

LIBPOSIX_PROCFS_SRCS-y += $(LIBPOSIX_PROCFS_BASE)/procfs.c
LIBPOSIX_PROCFS_SRCS-y += $(LIBPOSIX_PROCFS_BASE)/version.c
LIBPOSIX_PROCFS_SRCS-y += $(LIBPOSIX_PROCFS_BASE)/memory.c
